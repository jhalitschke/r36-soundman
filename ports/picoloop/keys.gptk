# gptokeyb mapping for picoloop. The keys come from Master.h in the picoloop
# source (block LINUX_RASPI1, identical to PC_DESKTOP and OPENDINGUX) - picoloop
# reads exactly these SDL keys and nothing else.
up = up
down = down
left = left
right = right
a = leftctrl
b = leftalt
x = space
y = leftshift
start = enter
select = esc
l1 = tab
r1 = backspace
